@* Selector de estilo (like https://demos.devexpress.com/blazor/), misma distribución: Modo
   Claro/Oscuro, Preset Colors (acentos Fluent), Color personalizado, separador, DevExpress
   Classic, separador, Bootstrap. Cada grupo resuelve a un arreglo de hojas de estilo que se
   inyectan juntas (frontOneTheme.aplicar, orden importa):
   - Fluent: DevExpress.Blazor.Themes.Fluent — 4 hojas obligatorias según la documentación oficial
     (core.min.css con las variables --dxds-*, global.min.css, modes/{light|dark}.min.css,
     accents/{color}.min.css). El archivo bootstrap/fluent-*.bs5.min.css NO sirve solo — es para
     integrarlo con Bootstrap real, y sin core.min.css ninguna variable de tamaño/espaciado existe.
   - Clásicos: DevExpress.Blazor.Themes (Blazing Berry/Dark, Purple, Office White) — 1 hoja.
   - Bootstrap: hoja Bootswatch de terceros (wwwroot/css/bootswatch, MIT) + el adaptador
     bootstrap-external.bs5.min.css de DevExpress.Blazor.Themes — 2 hojas. Siempre en modo Claro
     (pedido explícito del usuario: Claro/Oscuro solo aplica a los temas nativos DevExpress), por
     eso el toggle Modo se deshabilita mientras este grupo está activo.
   El toggle Claro/Oscuro controla el chrome propio del sitio (topbar/drawer/panel, tokens --fo-*
   en site.css vía [data-theme]) — Blazing Berry/Purple/Office White no tienen variante oscura
   propia, pero el chrome sí debe poder verse oscuro. El color de acento del swatch elegido tiñe
   el borde superior del topbar (--fo-accent). *@
@inject IJSRuntime JsRuntime

<button type="button" class="fo-theme-toggle" @onclick="TogglePanel" title="Cambiar estilo" aria-label="Cambiar estilo">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3" />
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
    </svg>
</button>

@if (_panelVisible)
{
    <div class="fo-theme-overlay" @onclick="ClosePanel"></div>
    <aside class="fo-theme-panel">
        <div class="fo-theme-panel-header">
            <span>Estilo</span>
            <button type="button" class="fo-theme-close" @onclick="ClosePanel" aria-label="Cerrar">×</button>
        </div>

        <div class="fo-theme-mode-row">
            <button type="button" class="fo-theme-mode-btn @(!_oscuro ? "activo" : "")" disabled="@(_grupo == Grupo.Bootstrap)" @onclick="@(() => CambiarModoAsync(false))">Claro</button>
            <button type="button" class="fo-theme-mode-btn @(_oscuro ? "activo" : "")" disabled="@(_grupo == Grupo.Bootstrap)" @onclick="@(() => CambiarModoAsync(true))">Oscuro</button>
        </div>

        <div class="fo-theme-section">
            <div class="fo-theme-section-title">Preset Colors</div>
            <div class="fo-theme-item-grid">
                @foreach (var acento in Acentos)
                {
                    var esActivo = _grupo == Grupo.Fluent && _accento == acento.Id;
                    <button type="button" class="fo-theme-item @(esActivo ? "activo" : "")" @onclick="@(() => SeleccionarAcentoAsync(acento.Id))">
                        <span class="fo-theme-item-swatch" style="background:@acento.ColorMuestra"></span>
                        <span>@acento.Nombre</span>
                    </button>
                }
            </div>
        </div>

        <div class="fo-theme-section">
            <div class="fo-theme-section-title">Color personalizado</div>
            <div class="fo-theme-custom-row">
                <input type="text" class="fo-theme-custom-input" placeholder="#hex" maxlength="7" @bind="_colorPersonalizado" @bind:event="oninput" />
                <button type="button" class="fo-theme-custom-btn" title="Aplicar" aria-label="Aplicar color personalizado" @onclick="AplicarColorPersonalizadoAsync">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5" /></svg>
                </button>
            </div>
        </div>

        <div class="fo-theme-section fo-theme-section-separada">
            <div class="fo-theme-section-title">DevExpress Classic</div>
            <div class="fo-theme-item-grid">
                @foreach (var tema in Clasicos)
                {
                    var esActivo = _grupo == Grupo.Clasico && _base == tema.Id;
                    <button type="button" class="fo-theme-item @(esActivo ? "activo" : "")" @onclick="@(() => SeleccionarClasicoAsync(tema.Id))">
                        <span class="fo-theme-item-swatch" style="background:@tema.ColorMuestra"></span>
                        <span>@tema.Nombre</span>
                    </button>
                }
            </div>
        </div>

        <div class="fo-theme-section fo-theme-section-separada">
            <div class="fo-theme-section-title">Bootstrap</div>
            <div class="fo-theme-item-grid">
                @foreach (var tema in Bootswatch)
                {
                    var esActivo = _grupo == Grupo.Bootstrap && _base == tema.Id;
                    <button type="button" class="fo-theme-item @(esActivo ? "activo" : "")" @onclick="@(() => SeleccionarBootstrapAsync(tema.Id))">
                        <span class="fo-theme-item-swatch" style="background:@tema.ColorMuestra"></span>
                        <span>@tema.Nombre</span>
                    </button>
                }
            </div>
        </div>
    </aside>
}

@code {
    private const string BootstrapAdaptador = "_content/DevExpress.Blazor.Themes/bootstrap-external.bs5.min.css";
    private const string FluentCore = "_content/DevExpress.Blazor.Themes.Fluent/core.min.css";
    private const string FluentGlobal = "_content/DevExpress.Blazor.Themes.Fluent/global.min.css";

    private enum Grupo { Clasico, Fluent, Bootstrap }

    private sealed record TemaInfo(string Id, string Nombre, string ColorMuestra);
    private sealed record TemaGuardado(string[]? Hrefs, bool Oscuro, string? ColorAcento, string? ColorPersonalizado);

    private static readonly TemaInfo[] Clasicos =
    [
        new("blazing-berry", "Blazing Berry", "#951b81"),
        new("blazing-dark", "Blazing Dark", "#1e1e1e"),
        new("purple", "Purple", "#7b61ff"),
        new("office-white", "Office White", "#f3f2f1"),
    ];

    // Hex exactos de ThemeFluentAccentColor (docs.devexpress.com/Blazor/DevExpress.Blazor.ThemeFluentAccentColor)
    // — antes eran aproximados a ojo y varios no correspondían al color real del tema.
    private static readonly TemaInfo[] Acentos =
    [
        new("blue", "Blue", "#0f6cbd"),
        new("cool-blue", "Cool Blue", "#2d7d9a"),
        new("desert", "Desert", "#847545"),
        new("mint", "Mint", "#018574"),
        new("moss", "Moss", "#486860"),
        new("orchid", "Orchid", "#c239b3"),
        new("purple", "Purple", "#5b5fc7"),
        new("rose", "Rose", "#ea005e"),
        new("rust", "Rust", "#da3b01"),
        new("steel", "Steel", "#68768a"),
        new("storm", "Storm", "#4c4a48"),
    ];

    private static readonly TemaInfo[] Bootswatch =
    [
        new("cerulean", "Cerulean", "#2fa4e7"),
        new("flatly", "Flatly", "#2c3e50"),
        new("journal", "Journal", "#eb6864"),
        new("lumen", "Lumen", "#158cba"),
    ];

    private bool _panelVisible;
    private bool _oscuro;
    private Grupo _grupo = Grupo.Clasico;
    private string _base = "blazing-berry";
    private string _accento = "blue";
    private string _colorPersonalizado = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var guardado = await JsRuntime.InvokeAsync<TemaGuardado?>("frontOneTheme.obtener");
        if (guardado is not null && RestaurarEstado(guardado))
        {
            StateHasChanged();
        }
    }

    // Detecta el grupo/tema activo a partir del arreglo de hrefs guardado — mismas rutas que
    // generan los métodos Seleccionar*Async de abajo, así que basta con reconocer un fragmento
    // distintivo de cada grupo.
    private bool RestaurarEstado(TemaGuardado guardado)
    {
        _oscuro = guardado.Oscuro;
        if (guardado.ColorPersonalizado is { Length: > 0 } colorGuardado)
        {
            _grupo = Grupo.Fluent;
            _accento = "custom";
            _colorPersonalizado = colorGuardado;
            return true;
        }

        var hrefs = guardado.Hrefs;
        if (hrefs is null || hrefs.Length == 0)
        {
            return true;
        }

        var externo = Array.Find(hrefs, h => h.StartsWith("css/bootswatch/", StringComparison.Ordinal));
        if (externo is not null)
        {
            _grupo = Grupo.Bootstrap;
            _base = ExtraerId(externo);
            return true;
        }

        var acento = Array.Find(hrefs, h => h.Contains("Themes.Fluent/accents/", StringComparison.Ordinal));
        if (acento is not null)
        {
            _grupo = Grupo.Fluent;
            _accento = ExtraerId(acento);
            return true;
        }

        var clasico = Array.Find(hrefs, h => h.Contains("DevExpress.Blazor.Themes/", StringComparison.Ordinal) && !h.Contains("bootstrap-external", StringComparison.Ordinal));
        if (clasico is not null)
        {
            _grupo = Grupo.Clasico;
            _base = ExtraerId(clasico);
            return true;
        }

        return true;
    }

    private static string ExtraerId(string ruta) => System.IO.Path.GetFileNameWithoutExtension(ruta).Replace(".bs5.min", "").Replace(".min", "");

    private void TogglePanel() => _panelVisible = !_panelVisible;

    private void ClosePanel() => _panelVisible = false;

    private Task CambiarModoAsync(bool oscuro)
    {
        if (_grupo == Grupo.Bootstrap)
        {
            return Task.CompletedTask; // Claro/Oscuro no aplica a Bootstrap — pedido explícito
        }

        _oscuro = oscuro;
        return ReaplicarGrupoActualAsync();
    }

    private async Task SeleccionarClasicoAsync(string id)
    {
        _grupo = Grupo.Clasico;
        _base = id;
        // Los 4 Clásicos son temas 100% claros, salvo Blazing Dark — así que TODOS fuerzan un
        // _oscuro explícito, no solo el par Blazing. Bug real que causó esto: dejar Purple/Office
        // White "sin tocar _oscuro" asumía que como no tienen variante oscura no importaba, pero
        // si el usuario venía de Oscuro (Blazing Dark o Fluent Oscuro) el modo se quedaba pegado
        // — el chrome se pintaba oscuro (tokens --fo-*) encima de un tema que es puramente claro,
        // rompiendo el render completo (reportado por el usuario con Purple).
        _oscuro = id == "blazing-dark";

        var color = Array.Find(Clasicos, t => t.Id == id)?.ColorMuestra;
        await (id == "blazing-berry"
            ? AplicarAsync([], color) // ya es el <link> default — vaciar el arreglo lo restaura sin pedirlo de nuevo
            : AplicarAsync([$"_content/DevExpress.Blazor.Themes/{id}.bs5.min.css"], color));
        ClosePanel();
    }

    private async Task SeleccionarAcentoAsync(string color)
    {
        _grupo = Grupo.Fluent;
        _accento = color;
        await AplicarFluentAsync();
        ClosePanel();
    }

    private async Task AplicarColorPersonalizadoAsync()
    {
        var hex = _colorPersonalizado.Trim();
        if (!System.Text.RegularExpressions.Regex.IsMatch(hex, "^#[0-9a-fA-F]{6}$"))
        {
            return; // color inválido — no hace nada, el usuario sigue viendo lo que ya tenía
        }

        _grupo = Grupo.Fluent;
        _accento = "custom";
        await AplicarFluentAsync(hex);
        ClosePanel();
    }

    private async Task SeleccionarBootstrapAsync(string id)
    {
        _grupo = Grupo.Bootstrap;
        _base = id;
        _oscuro = false; // Bootstrap siempre en modo Claro — pedido explícito del usuario
        var color = Array.Find(Bootswatch, t => t.Id == id)?.ColorMuestra;
        await AplicarAsync([$"css/bootswatch/{id}.min.css", BootstrapAdaptador], color);
        ClosePanel();
    }

    // Re-emite el mismo grupo/selección activa — usado al cambiar Claro/Oscuro, que no cambia
    // QUÉ tema DX está activo (Purple/Office White no tienen variante oscura propia), solo el
    // chrome del sitio.
    private Task ReaplicarGrupoActualAsync() => _grupo switch
    {
        Grupo.Fluent => AplicarFluentAsync(),
        _ => _base == "blazing-berry"
            ? AplicarAsync([], Array.Find(Clasicos, t => t.Id == _base)?.ColorMuestra)
            : AplicarAsync([$"_content/DevExpress.Blazor.Themes/{_base}.bs5.min.css"], Array.Find(Clasicos, t => t.Id == _base)?.ColorMuestra),
    };

    // colorPersonalizado: cuando viene de AplicarColorPersonalizadoAsync, se usa el hex tal cual
    // como overlay de acento en vez de un archivo accents/{color}.min.css — ponytail: aplica el
    // mismo hex a los 17 pasos --dxds-primary-* (sin degradado propio); si algún día hace falta
    // el degradado real, ahí es donde generar la escala completa (algoritmo de DevExpress).
    private Task AplicarFluentAsync(string? colorPersonalizadoHex = null)
    {
        var modo = _oscuro ? "dark" : "light";
        var hrefs = new List<string> { FluentCore, FluentGlobal, $"_content/DevExpress.Blazor.Themes.Fluent/modes/{modo}.min.css" };
        string color;

        // El archivo accents/{color}.min.css no trae solo el acento (--dxds-primary-*) — también
        // es la ÚNICA fuente de la escala "neutral" (--dxds-neutral-*, de la que depende el fondo
        // de body/grid vía --dxds-color-surface-neutral-default-rest). Confirmado inspeccionando
        // el CSS: esa escala es idéntica en los 11 archivos de acento. Bug real que esto corrige:
        // con color personalizado se omitía el archivo por completo (solo se inyectaban las
        // variables --dxds-primary-*), dejando la escala neutral sin definir → fondo transparente
        // en toda la página. "blue" aquí es solo la base neutral; el hex del usuario pisa
        // --dxds-primary-* después vía el <style> inyectado (frontOneAplicarColorPersonalizado).
        hrefs.Add("_content/DevExpress.Blazor.Themes.Fluent/accents/blue.min.css");

        if (colorPersonalizadoHex is not null)
        {
            color = colorPersonalizadoHex;
        }
        else
        {
            hrefs[^1] = $"_content/DevExpress.Blazor.Themes.Fluent/accents/{_accento}.min.css";
            color = Array.Find(Acentos, t => t.Id == _accento)?.ColorMuestra ?? "#1582e1";
        }

        return AplicarAsync([.. hrefs], color, colorPersonalizadoHex);
    }

    private Task AplicarAsync(string[] hrefs, string? colorAcento, string? colorPersonalizadoHex = null)
        => JsRuntime.InvokeVoidAsync(
            "frontOneTheme.aplicar",
            hrefs,
            _oscuro,
            colorAcento,
            colorPersonalizadoHex).AsTask();
}
