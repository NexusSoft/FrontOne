    private void MostrarEstimaciones(IReadOnlyList<EstimacionBusquedaDto> resultados)
    {
        _estimaciones = resultados
            .Select(e => new EstimacionGridRow(e.Id, e.Folio, e.Fecha, e.HuertaNombre, e.PrecioSugerido,
                e.Cerrada ? "Cerrada" : (e.Autorizada ? "Autorizada" : "Pendiente de autorizar")))
            .ToList();
    }

    private Task SeleccionarEstimacionAsync(int id) => EjecutarAsync(async () =>
    {
        var dto = await EstimacionService.ObtenerPorIdAsync(id);
        if (dto is null) return;
        await CargarEstimacionAsync(dto);
        _popupEstimacionesVisible = false;
    });

    private async Task CargarEstimacionAsync(EstimacionDto dto)
    {
        // Obtener los precios antes de reemplazar la captura evita mezclar folios si falla SQL.
        var precios = await ListaPrecioFrutaService.ObtenerPorFechaAsync(dto.ListaPrecioFecha, dto.ListaPrecioProductorId);
        _estimacionId = dto.Id;
        _cerrada = dto.Cerrada;
        _autorizada = dto.Autorizada;
        // La asignación directa no dispara @bind:after: conserva la vigencia guardada.
        _usarListaMasReciente = dto.UsarListaMasReciente;
        _folio = dto.Folio;
        _fecha = dto.Fecha;
        _huertaId = dto.HuertaId;
        _huertaNombre = dto.HuertaNombre;
        _registroSagarpa = dto.RegistroSagarpa ?? string.Empty;
        _kilos = dto.Kilos;
        _acopiadorId = dto.AcopiadorId;
        _acopiadorNombre = dto.AcopiadorNombre;
        _cat1 = dto.PorcentajeCat1;
        _cat2 = dto.PorcentajeCat2;
        _nal = dto.PorcentajeNal;
        _calibre32 = dto.PorcentajeCalibre32;
        _calibre36 = dto.PorcentajeCalibre36;
        _calibre40 = dto.PorcentajeCalibre40;
        _calibre48 = dto.PorcentajeCalibre48;
        _calibre60 = dto.PorcentajeCalibre60;
        _calibre70 = dto.PorcentajeCalibre70;
        _calibre84 = dto.PorcentajeCalibre84;
        _calibre90 = dto.PorcentajeCalibre90;
        _borona = dto.PorcentajeBorona;
        _canica = dto.PorcentajeCanica;
        _cuarta = dto.PorcentajeCuarta;
        _desecho = dto.PorcentajeDesecho;
        _proceso = dto.PorcentajeProceso;
        _nombreListaSeleccionada = ListasPrecioFruta.Nombres[dto.TipoLista];
        _vigenciaSeleccionada = new VigenciaListaPrecioFrutaDto(dto.ListaPrecioFecha, dto.ListaPrecioProductorId, null);
        _preciosVigencia = [.. precios];
        _textoVigencia = $"{dto.ListaPrecioFecha:dd/MM/yyyy}";
        ActualizarAvisos();
        RecalcularPrecioSugerido();

        if (SoloLectura)
        {
            MostrarMensaje(_autorizada
                ? "Esta estimación ya está autorizada y no se puede editar. Desautorízala primero."
                : "Esta estimación ya está asignada a una Orden de Corte y no se puede editar.");
        }
    }

    private Task GuardarAsync() => EjecutarAsync(async () =>
    {
        if (SoloLectura) return;
        if (_huertaId is not { } huertaId)
        {
            MostrarMensaje("Busca y selecciona la huerta.");
            return;
        }
        if (_vigenciaSeleccionada is null || _preciosVigencia.Count == 0)
        {
            MostrarMensaje("Busca y carga una Lista de Precios.");
            return;
        }

        var dto = new EstimacionDto(
            _estimacionId ?? 0,
            string.Empty,
            _fecha,
            huertaId,
            _huertaNombre,
            string.IsNullOrWhiteSpace(_registroSagarpa) ? null : _registroSagarpa,
            _kilos,
            _acopiadorId,
            _acopiadorId is int ? _acopiadorNombre : null,
            _cat1,
            _cat2,
            _nal,
            _calibre32,
            _calibre36,
            _calibre40,
            _calibre48,
            _calibre60,
            _calibre70,
            _calibre84,
            _calibre90,
            _borona,
            _canica,
            _cuarta,
            _desecho,
            _proceso,
            _vigenciaSeleccionada.Fecha,
            _vigenciaSeleccionada.ProductorId,
            (byte)ListasPrecioFruta.Nombres.ToList().IndexOf(_nombreListaSeleccionada),
            _precioSugeridoActual,
            false,
            false,
            _usarListaMasReciente);

        if (_estimacionId is null)
        {
            var resultado = await EstimacionService.GuardarAsync(dto);
            _estimacionId = resultado.Id;
            _folio = resultado.Folio;
            MostrarMensaje($"Estimación guardada con folio {resultado.Folio}.");
        }
        else
        {
            await EstimacionService.ActualizarAsync(dto with { Id = _estimacionId.Value });
            MostrarMensaje("Estimación actualizada.");
        }
    });

    private Task NuevoAsync()
    {
        if (_ocupado) return Task.CompletedTask;
        _estimacionId = _huertaId = _acopiadorId = null;
        _folio = _huertaNombre = _registroSagarpa = string.Empty;
        _acopiadorNombre = null;
        _fecha = DateTime.Today;
        _cerrada = _autorizada = _usarListaMasReciente = false;
        _kilos = _cat1 = _cat2 = _nal = 0m;
        _calibre32 = _calibre36 = _calibre40 = _calibre48 = _calibre60 = _calibre70 = _calibre84 = _calibre90 = 0m;
        _borona = _canica = _cuarta = _desecho = _proceso = 0m;
        _nombreListaSeleccionada = ListasPrecioFruta.Nombres[0];
        _error = null;
        _mensaje = string.Empty;
        _mensajeInfoVisible = _popupVigenciasVisible = _popupHuertasVisible = _popupEstimacionesVisible = false;
        LimpiarVigencia();
        ActualizarAvisos();
        return Task.CompletedTask;
    }
