<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>frontone-web-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrontOne.Domain\FrontOne.Domain.csproj" />
    <ProjectReference Include="..\FrontOne.Application\FrontOne.Application.csproj" />
    <ProjectReference Include="..\FrontOne.Infrastructure.SqlServer\FrontOne.Infrastructure.SqlServer.csproj" />
    <ProjectReference Include="..\FrontOne.Infrastructure.SapB1\FrontOne.Infrastructure.SapB1.csproj" />
    <ProjectReference Include="..\FrontOne.Shared\FrontOne.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.Blazor" Version="26.1.3" />
    <PackageReference Include="DevExpress.Blazor.Themes" Version="26.1.3" />
    <PackageReference Include="DevExpress.Blazor.es" Version="26.1.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
